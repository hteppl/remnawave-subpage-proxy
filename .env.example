# Remnawave
UPSTREAM_URL=http://remnawave-subscription-page:3010
REMNAWAVE_PANEL_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=


# Listener
APP_HOST=0.0.0.0
APP_PORT=3020

HEALTH_HOST=0.0.0.0
HEALTH_PORT=3021


# Optional, defaults to /app/config.yaml
CONFIG_PATH=
# Must match the subscription page setting
CUSTOM_SUB_PREFIX=
# true | false | hop count | presets, IPs and CIDRs
TRUST_PROXY=1
# Only for edges that do not send X-Forwarded-Proto
UPSTREAM_FORCE_HTTPS=false


# Panel
PANEL_ENABLED=true
PANEL_ALWAYS_FETCH=false
PANEL_FORWARD_REAL_IP=true
PANEL_TIMEOUT=10s

CACHE_TTL=30s
CACHE_NEGATIVE_TTL=10s
CACHE_MAX_ENTRIES=10000

# Panel behind "Caddy with security" or Tiny Auth
CADDY_AUTH_API_TOKEN=

# Panel behind Cloudflare Zero Trust
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=


# Replays the last good response while Remnawave is down
SUBSCRIPTION_CACHE_ENABLED=false
SUBSCRIPTION_CACHE_TTL=1h

# Accepts 1MiB, 512KB or plain bytes
SUBSCRIPTION_CACHE_MAX_BYTES=64MiB
SUBSCRIPTION_CACHE_MAX_BODY=1MiB


# Timeouts
UPSTREAM_TIMEOUT=60s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s


# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=json

## Bundled remnawave/subscription-page
## https://github.com/remnawave/subscription-page

APP_PORT=3010

REMNAWAVE_PANEL_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=

# Must match CUSTOM_SUB_PREFIX in the proxy .env
CUSTOM_SUB_PREFIX=

# One hop: the proxy. Describe anything in front of it in the proxy TRUST_PROXY
TRUST_PROXY=1

CADDY_AUTH_API_TOKEN=
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=""
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=""

MARZBAN_LEGACY_LINK_ENABLED=false
MARZBAN_LEGACY_SECRET_KEY=
MARZBAN_LEGACY_SUBSCRIPTION_VALID_FROM=
